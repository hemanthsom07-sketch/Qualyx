# Copy this file to .env and fill in real local values.
# .env should NOT be committed to git.

# PostgreSQL connection string.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://qualyx_user:qualyx_password@localhost:5432/qualyx

# Set to true only for local development convenience (e.g. auto-create tables
# without migrations). Should be false once Alembic migrations are introduced.
DB_AUTO_CREATE=true

# App environment: local | test | staging | production
APP_ENV=local
