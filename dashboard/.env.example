# Backend API base URL.
#
# Local-dev default matches the backend's own default host/port (see
# backend/app/main.py, run via e.g. `uvicorn app.main:app`) and is
# already present in the backend's CORS allow-list
# (backend/app/config.py: cors_allowed_origins includes this dashboard's
# Vite dev server origin, http://localhost:5173).
#
# Copy this file to .env.local (or .env) and adjust if your backend runs
# elsewhere. Do not commit a real .env file.
VITE_API_BASE_URL=http://localhost:8000
